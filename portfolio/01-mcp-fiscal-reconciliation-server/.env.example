# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Secret key used by security/anonymizer.py to pseudonymize identifiers.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
ANONYMIZER_SECRET_KEY=

# Where the encrypted credentials file lives (see security/secrets_manager.py)
ENCRYPTED_CREDENTIALS_PATH=credentials.enc
